# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Use a long random value in each environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Defaults to http://127.0.0.1:8010.
OCR_SERVICE_URL="http://127.0.0.1:8010"

# Python interpreter used by the CAD converter and DWG column worker.
# Create it with: python3 -m venv .venv-dwg
DWG_PYTHON_PATH=".venv-dwg/bin/python"
# Optional path override for the standalone DWG -> DXF converter script.
# DWG_DXF_CONVERTER_SCRIPT="python/dwg_worker/convert_to_dxf.py"
# Optional override; by default backend uses python/dwg_worker/main.py.
# DWG_WORKER_SCRIPT="python/dwg_worker/main.py"
