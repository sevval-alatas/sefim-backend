# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Use a long random value in each environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Defaults to http://127.0.0.1:8010.
OCR_SERVICE_URL="http://127.0.0.1:8010"

# Absolute path to the Python interpreter in the environment containing ezdwg.
DWG_PYTHON_PATH="/path/to/python-dwg-env/bin/python"
# Optional override; by default backend uses python/dwg_worker/main.py.
# DWG_WORKER_SCRIPT="python/dwg_worker/main.py"

# Android .so DWG okucusu köprüsü (opsiyonel)
# Yerel yürütülebilir dosya yolu (ARM64 Android .so doğrudan çalışmaz; uyumlu bir wrapper/bridge gerekir)
ANDROID_DWG_BRIDGE_COMMAND="/path/to/android-dwg-bridge"
ANDROID_DWG_BRIDGE_ARGS="--dwg-worker"

# Veya Android cihazda/Termux'ta çalışan HTTP bridge adresi
# ANDROID_DWG_BRIDGE_URL="http://127.0.0.1:8020"

# Python .so bridge için (android_bridge/android_dwg_bridge.py)
ANDROID_DWG_SO_PATH="/path/to/libdwgreader.so"
ANDROID_DWG_FUNC_NAME="read_dwg"
ANDROID_DWG_HOST="127.0.0.1"
ANDROID_DWG_PORT="8020"
