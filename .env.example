# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Use a long random value in each environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Defaults to http://127.0.0.1:8010.
OCR_SERVICE_URL="http://127.0.0.1:8010"

# Absolute path to the Python interpreter in the environment containing ezdwg.
DWG_PYTHON_PATH="/path/to/python-dwg-env/bin/python"
# Optional override; by default backend uses python/dwg_worker/main.py.
# DWG_WORKER_SCRIPT="python/dwg_worker/main.py"
